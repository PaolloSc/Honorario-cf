# Ambiente do backend em produção (espelha backend/.env.example)
# DATABASE_URL e DOCUSEAL_BASE_URL são definidos no docker-compose.yml — não repetir aqui.

# Azure AD / Microsoft Graph API (envio de e-mails)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=

# DocuSeal — token de Settings -> API da instância self-hosted
DOCUSEAL_API_KEY=
# Gerar com: openssl rand -hex 32 — mesmo valor vai no secret header
# X-Docuseal-Secret do webhook configurado no DocuSeal
DOCUSEAL_WEBHOOK_SECRET=

# URL do frontend na Vercel (CORS)
CORS_ORIGINS=https://honorario-cf.vercel.app

# Financeiro / Testemunha 1 fixa
FINANCEIRO_EMAIL=financeiro@carvalhofurtadoadv.com.br,gabriel@carvalhofurtadoadv.com.br
TESTEMUNHA1_NOME=Lilian Siqueira
TESTEMUNHA1_EMAIL=financeiro@carvalhofurtadoadv.com.br

# NFS-e BH (desligado por padrão)
NFSE_ENABLED=false
