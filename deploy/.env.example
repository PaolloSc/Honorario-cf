# Domínios públicos (DNS dos dois deve apontar para esta VM)
API_HOST=api.carvalhofurtadoadv.com.br
DOCUSEAL_HOST=docuseal.carvalhofurtadoadv.com.br

# Gerar com: openssl rand -hex 64
SECRET_KEY_BASE=

# Senha dos Postgres internos (backend e DocuSeal)
POSTGRES_PASSWORD=

# SMTP — obrigatório: é por aqui que o DocuSeal envia os convites de assinatura
SMTP_ADDRESS=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=contrato@carvalhofurtadoadv.com.br
SMTP_DOMAIN=carvalhofurtadoadv.com.br
