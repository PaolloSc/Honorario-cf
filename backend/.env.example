# Azure AD / Microsoft Graph API
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=

# DocuSeal API — ver docs/runbooks/docuseal-producao.md
# Nuvem: https://api.docuseal.com | Self-hosted (Docker): https://<seu-dominio>/api
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=https://api.docuseal.com
# Obrigatório em produção: sem ele o webhook responde 403 e o status nunca vira "assinado".
# Mesmo valor vai no secret header X-Docuseal-Secret do webhook configurado no DocuSeal.
DOCUSEAL_WEBHOOK_SECRET=

# Dados do escritório — sem valor padrão no código; todos obrigatórios em produção
# (VERCEL_ENV=production: o backend não sobe sem eles). Valores abaixo são exemplos.
FINANCEIRO_EMAIL=financeiro@exemplo.com.br,socio@exemplo.com.br
CF_SIGNER_EMAIL=contrato@exemplo.com.br
TESTEMUNHA1_NOME=Nome da Testemunha
TESTEMUNHA1_EMAIL=financeiro@exemplo.com.br
BANK_ACCOUNT_INFO=Banco X, agência 0000, conta corrente 00000-0, ou chave Pix (CNPJ) 00000000000000

# Banco: vazio = SQLite local (só desenvolvimento). Obrigatório em produção.
DATABASE_URL=

# Legal One (só leitura; sem credenciais a busca de partes fica desligada)
LEGALONE_API_CLIENT_ID=
LEGALONE_API_CLIENT_SECRET=

# DeepSeek (endpoint compativel Anthropic) — varredura de portugues do contrato no Step7
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-chat

# App settings
CORS_ORIGINS=https://your-frontend.vercel.app
TEMPLATE_PATH=templates/timbrado_peticao_1.dotx
OUTPUT_DIR=generated_contracts

# NFS-e BH
NFSE_ENABLED=false
NFSE_KEK=                            # base64(32 bytes) — gerar com: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
NFSE_WORKER_TOKEN=                   # 48+ chars aleatórios
NFSE_BACKFILL_DAYS=90
NFSE_GH_ACTIONS_CIDRS=               # opcional, CSV
